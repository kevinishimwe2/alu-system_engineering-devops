#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
WEB01_IP="3.8.148.34"
WEB02_IP="13.40.44.66"

sudo service nginx stop 2>/dev/null
sudo apt-get update
sudo apt-get install -y haproxy

[ -f /etc/haproxy/haproxy.cfg.orig ] || sudo cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.orig
sudo cp /etc/haproxy/haproxy.cfg.orig /etc/haproxy/haproxy.cfg

cat <<EOF | sudo tee -a /etc/haproxy/haproxy.cfg
frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7137-web-01 $WEB01_IP:80 check
    server 7137-web-02 $WEB02_IP:80 check
EOF

grep -q '^ENABLED=1' /etc/default/haproxy 2>/dev/null || echo "ENABLED=1" | sudo tee -a /etc/default/haproxy
sudo service haproxy restart
